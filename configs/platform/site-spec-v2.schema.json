{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "configs/platform/site-spec-v2.schema.json",
  "title": "Generic SiteSpec v2",
  "description": "Generic / arbitrary-site onboarding contract (Slice B, #1287). This is a SEPARATE namespace from the v1 Buk-gu SiteSpec (configs/sitespec.schema.json) and is NOT read by the current v1 SiteSpecResolver glob (configs/sites/*.sitespec.json). Schema-only contract: cross-field invariants (identity collision, entry-point host ownership, capability entry-point references, safety/state coupling) are enforced by pure-stdlib pytest semantic helpers, not by JSON Schema. No runtime wiring, no live network, no external write authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "identity",
    "domains",
    "entry_points",
    "archetype",
    "capabilities",
    "capture_policy",
    "browser_policy",
    "knowledge_policy",
    "action_policy",
    "provenance",
    "extensions"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "2.0.0",
      "description": "Generic v2 contract line. Fixed for Slice B. v2 is never silently accepted by the v1 resolver."
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site_id", "legacy_ids", "display"],
      "properties": {
        "site_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "description": "Canonical immutable machine site ID. Must never equal any legacy_ids entry (enforced by semantic test)."
        },
        "legacy_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "description": "Legacy/runtime compatibility aliases. May be empty. Canonical site_id must not appear here. No duplicate aliases."
        },
        "display": {
          "type": "object",
          "additionalProperties": false,
          "required": ["default_label", "locale_labels"],
          "properties": {
            "default_label": {
              "type": "string",
              "minLength": 1,
              "description": "Human display label. NOT a runtime identifier."
            },
            "locale_labels": {
              "type": "object",
              "minProperties": 0,
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              },
              "description": "Locale-keyed display labels. Display labels are NOT runtime identity."
            }
          }
        }
      }
    },
    "domains": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public"],
      "properties": {
        "public": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?(\\.[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?)+$"
          },
          "description": "Declared public-domain scope. Declarative only. Domain presence is NOT live-network authorization."
        }
      }
    },
    "entry_points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "url"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "description": "Stable local reference ID. Unique within one SiteSpec (enforced by semantic test)."
          },
          "kind": {
            "type": "string",
            "enum": [
              "homepage",
              "search",
              "service",
              "notice",
              "document",
              "directory",
              "other"
            ]
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "pattern": "^https?://",
            "description": "Absolute http(s) URL. Declarative only; no fetch is performed in Slice B. Parsed hostname must be declared in domains.public (enforced by semantic test)."
          }
        }
      }
    },
    "archetype": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state", "confidence", "evidence_refs"],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "municipality",
            "university",
            "bank",
            "public_agency",
            "support_portal",
            "company",
            "unknown"
          ]
        },
        "state": {
          "type": "string",
          "enum": ["configured", "detected", "unknown", "review_required"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "state",
          "confidence",
          "safety_level",
          "entry_points",
          "evidence_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "site_search",
              "notice_board",
              "document_library",
              "directory",
              "service_catalog",
              "faq",
              "calendar",
              "form",
              "contact",
              "map_or_location",
              "auth_boundary"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "configured",
              "detected",
              "unsupported",
              "review_required",
              "not_detected"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "safety_level": {
            "type": "string",
            "enum": [
              "read_only",
              "navigate",
              "prepare_input",
              "high_risk_boundary",
              "unsupported"
            ]
          },
          "entry_points": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_-]*$"
            },
            "description": "References to declared entry-point IDs. Dangling references fail closed (enforced by semantic test)."
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "capture_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acquisition_mode", "live_network_authorized"],
      "properties": {
        "acquisition_mode": {
          "type": "string",
          "enum": ["offline_fixture", "synthetic"]
        },
        "live_network_authorized": {
          "type": "boolean"
        }
      }
    },
    "browser_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_mode", "actual_site_control_authorized"],
      "properties": {
        "surface_mode": {
          "type": "string",
          "enum": ["generated_preview", "controlled_clone"]
        },
        "actual_site_control_authorized": {
          "type": "boolean"
        }
      }
    },
    "knowledge_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grounding_required", "provenance_required"],
      "properties": {
        "grounding_required": {
          "type": "boolean"
        },
        "provenance_required": {
          "type": "boolean"
        }
      }
    },
    "action_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["external_write_authorized", "high_risk_actions_authorized"],
      "properties": {
        "external_write_authorized": {
          "type": "boolean",
          "description": "No safety_level or capability state authorizes external write, login, payment, submit, upload, or PII handling."
        },
        "high_risk_actions_authorized": {
          "type": "boolean"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_refs", "review_state"],
      "properties": {
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "review_state": {
          "type": "string",
          "enum": ["synthetic", "review_required", "reviewed"]
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "municipality": {
          "type": "object",
          "additionalProperties": false,
          "required": ["jurisdiction"],
          "properties": {
            "jurisdiction": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "canonical_name",
                "short_name",
                "effective_from",
                "historical_aliases"
              ],
              "properties": {
                "canonical_name": {
                  "type": "string",
                  "minLength": 1
                },
                "short_name": {
                  "type": "string",
                  "minLength": 1
                },
                "effective_from": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                "historical_aliases": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["value", "effective_until"],
                    "properties": {
                      "value": {
                        "type": "string",
                        "minLength": 1
                      },
                      "effective_until": {
                        "type": "string",
                        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "university": {
          "type": "object",
          "additionalProperties": false,
          "required": ["institution_label"],
          "properties": {
            "institution_label": {
              "type": "string",
              "minLength": 1
            },
            "institution_type": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "financial": {
          "type": "object",
          "additionalProperties": false,
          "required": ["institution_label"],
          "properties": {
            "institution_label": {
              "type": "string",
              "minLength": 1
            },
            "institution_type": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
