{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "configs/contracts/runtime-vocabulary.schema.json",
  "title": "Runtime Vocabulary Inventory Contract",
  "description": "Declarative, versioned inventory of every runtime vocabulary surface that is currently source-of-truth across Python and Cloudflare. This is an OFFLINE drift contract artifact: it records the current canonical state of each vocabulary. It is NOT a runtime loader input and is NOT wired into any runtime. Runtime wiring is a future slice. (#1228-A)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "inventory_only",
    "runtime_wired",
    "site_identity",
    "actions",
    "locales",
    "evidence",
    "freshness",
    "providers",
    "api_control"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "inventory_only": {
      "type": "boolean",
      "const": true,
      "description": "True means this manifest is a read-only inventory/drift contract, not a runtime configuration source."
    },
    "runtime_wired": {
      "type": "boolean",
      "const": false,
      "description": "False means no runtime consumes this manifest. Runtime wiring is a future slice."
    },
    "site_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_site_id",
        "legacy_ids",
        "display_names",
        "historical_jurisdiction_names",
        "python_runtime_profile",
        "cloudflare_adapter",
        "registry_default_site_id"
      ],
      "properties": {
        "canonical_site_id": {
          "type": "string",
          "minLength": 1
        },
        "legacy_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "display_names": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "historical_jurisdiction_names": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "python_runtime_profile": {
          "type": "string",
          "minLength": 1
        },
        "cloudflare_adapter": {
          "type": "string",
          "minLength": 1
        },
        "registry_default_site_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "journey_actions",
        "no_action_sentinel",
        "action_snapshot_routes"
      ],
      "properties": {
        "journey_actions": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9_]*$" }
        },
        "no_action_sentinel": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "is_journey_action"],
          "properties": {
            "value": { "type": "string", "minLength": 1 },
            "is_journey_action": { "type": "boolean", "const": false }
          }
        },
        "action_snapshot_routes": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "locales": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported"],
      "properties": {
        "supported": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z]{2}$" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["levels", "verified_levels"],
      "properties": {
        "levels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "verified_levels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "cloudflare"],
      "properties": {
        "python": {
          "type": "object",
          "additionalProperties": false,
          "required": ["states"],
          "properties": {
            "states": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "cloudflare": {
          "type": "object",
          "additionalProperties": false,
          "required": ["states"],
          "properties": {
            "states": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "cloudflare"],
      "properties": {
        "python": {
          "type": "object",
          "additionalProperties": false,
          "required": ["live_provider_ids", "test_provider_ids"],
          "properties": {
            "live_provider_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "test_provider_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "cloudflare": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider_ids", "default_order", "provider_details"],
          "properties": {
            "provider_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "default_order": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "provider_details": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["default_model", "secret_env", "model_env"],
                "properties": {
                  "default_model": { "type": "string", "minLength": 1 },
                  "secret_env": { "type": "string", "minLength": 1 },
                  "model_env": { "type": "string", "minLength": 1 },
                  "fallback_model": { "type": "string", "minLength": 1 },
                  "fallback_model_env": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    "api_control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_schema_version",
        "ai_runtime_modes",
        "ai_mode_env"
      ],
      "properties": {
        "api_schema_version": {
          "type": "string",
          "minLength": 1
        },
        "ai_runtime_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "ai_mode_env": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
