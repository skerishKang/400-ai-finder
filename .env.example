# =============================================================================
# 400-ai-finder — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- LLM Provider Configuration ---
# Supported values: mock, stub, opencode-go, opengateway, nvidia, kilocode,
#                   mistral, groq, opencode-zen, nous
AI_FINDER_LLM_PROVIDER=mock

# --- Mock Provider ---
AI_FINDER_MOCK_RESPONSE=이것은 mock provider 응답입니다.

# --- Stub Provider ---
# Generates source-based simulated responses. No API key required.
# AI_FINDER_LLM_PROVIDER=stub

# --- OpenCode-Go ---
# https://github.com/nousresearch/opencode-go
# OPENCODE_GO_API_KEY=your-opencode-go-api-key
# OPENCODE_GO_BASE_URL=https://api.opencode-go.com/v1

# --- Mistral AI ---
# https://console.mistral.ai/
# MISTRAL_API_KEY=your-mistral-api-key

# --- OpenGateway / OpenCodeGo ---
# OPENGATEWAY_API_KEY=your-opengateway-api-key

# --- KiloCode ---
# https://kilo.app/
# KILOCODE_API_KEY=your-kilocode-api-key

# --- Cloudflare MVP model routing ---
# Operators control provider priority. Residents never receive or choose provider keys.
MVP_LLM_ORDER=gemini,hy3

# Gemini primary: the operator key currently uses Google's OpenAI-compatible API.
# GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_STYLE=openai
GEMINI_API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# Optional Gemini Search grounding mode for a key that supports Interactions API:
# GEMINI_API_STYLE=interactions
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/interactions

# HY3 secondary fallback through KiloCode.
# KILOCODE_API_KEY=your-kilocode-api-key
HY3_MODEL=tencent/hy3:free
HY3_API_ENDPOINT=https://api.kilo.ai/api/gateway/v1/chat/completions

# --- NVIDIA NIM ---
# https://build.nvidia.com/
# NVIDIA_API_KEY=your-nvidia-api-key

# --- Groq ---
# https://console.groq.com/
# GROQ_API_KEY=your-groq-api-key

# --- OpenCode-Zen ---
# https://github.com/nousresearch/opencode-zen
# OPENCODE_ZEN_API_KEY=your-opencode-zen-api-key
# OPENCODE_ZEN_BASE_URL=https://api.opencode-zen.com/v1

# --- Nous Research ---
# https://github.com/nousresearch/nous
# NOUS_API_KEY=your-nous-api-key
# NOUS_BASE_URL=https://api.nousresearch.com/v1

# =============================================================================
# Fetch Provider Configuration
# =============================================================================
# Supported values: mock, requests, firecrawl
AI_FINDER_FETCH_PROVIDER=requests

# --- Mock Fetch Provider ---
AI_FINDER_FETCH_MOCK_MARKDOWN=이것은 mock fetch markdown입니다.
AI_FINDER_FETCH_MOCK_HTML=<html><head><title>Mock Page</title></head><body>Mock body</body></html>
AI_FINDER_FETCH_MOCK_TITLE=Mock Page

# --- Firecrawl Fetch Provider ---
# https://www.firecrawl.dev/
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
FIRECRAWL_API_KEY=replace-with-your-firecrawl-api-key
FIRECRAWL_TIMEOUT=60

# --- Public MVP request safety (#1224-A) ---
# Application-level JSON request body limit. Valid range: 1024..32768 bytes.
# Invalid/out-of-range values fall back to the safe 8192-byte default.
MVP_MAX_BODY_BYTES=8192

# --- Public MVP Turnstile bot defense (#1224-B) ---
# Production/default is fail-closed: required. `disabled` is honored only on
# exact loopback hosts for local/offline tests and cannot disable production.
MVP_TURNSTILE_MODE=required
# Public browser site key. Configure the actual key in Cloudflare before merge/deploy.
MVP_TURNSTILE_SITE_KEY=replace-with-your-turnstile-site-key
# NEVER commit the real secret. Store MVP_TURNSTILE_SECRET_KEY as an encrypted
# Cloudflare Pages/Workers secret in the deployment environment.
# MVP_TURNSTILE_SECRET_KEY=replace-with-your-turnstile-secret-key
MVP_TURNSTILE_EXPECTED_ACTION=mvp_ask
# Comma-separated exact Siteverify hostnames. Add each explicitly authorized
# production/preview hostname; do not use wildcards.
MVP_TURNSTILE_ALLOWED_HOSTNAMES=cgbukku.pages.dev
# Siteverify timeout only; bounded by the global #1227 request deadline.
# Valid range: 250..10000 ms. Invalid values fall back to 3000 ms.
MVP_TURNSTILE_TIMEOUT_MS=3000
# The repository live build emits no Cloudflare _headers/CSP policy. If the
# deployment adds CSP, explicitly review Turnstile's challenges.cloudflare.com
# script/frame origins before activation; dashboard header transforms remain a
# deployment gate rather than an application default.
